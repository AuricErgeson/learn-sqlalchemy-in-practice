# Copy to .env and set the path for your machine.
#
# The path must be ABSOLUTE. A bare filename (sqlite:///retrofun.sqlite) is
# resolved against the current working directory, so running a script from
# Exercises/ would silently create a second, empty database there.
#
# Linux/macOS: sqlite:////home/you/learn-sqlalchemy-in-practice/retrofun/retrofun.sqlite
# Windows:     sqlite:///C:/path/to/learn-sqlalchemy-in-practice/retrofun/retrofun.sqlite

DATABASE_URL=sqlite:///C:/path/to/learn-sqlalchemy-in-practice/retrofun/retrofun.sqlite